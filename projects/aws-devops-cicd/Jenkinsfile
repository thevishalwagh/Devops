pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }
    
        stage('Create Virtual Environment') {
            steps {
                dir('projects/aws-devops-cicd') {
                    sh 'python3 -m venv venv'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('projects/aws-devops-cicd') {
                    sh 'venv/bin/python -m pip install --upgrade pip'
                    sh 'venv/bin/python -m pip install -r requirements.txt'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('projects/aws-devops-cicd') {
                    sh 'venv/bin/python -m pytest'
                }
            }
        }

        stage('Build and Push Docker Image') {
    steps {
        dir('projects/aws-devops-cicd') {
            withCredentials([[
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'aws-wagh'
            ]]) {
                sh '''
                    aws ecr get-login-password --region ap-south-1 | \
                    docker login --username AWS --password-stdin \
                    093954666101.dkr.ecr.ap-south-1.amazonaws.com

                    docker build -t devops-dashboard:ci .

                    docker tag devops-dashboard:ci \
                    093954666101.dkr.ecr.ap-south-1.amazonaws.com/devops-dashboard:ci

                    docker push \
                    093954666101.dkr.ecr.ap-south-1.amazonaws.com/devops-dashboard:ci
                '''
            }
        }
    }
}
    }
}